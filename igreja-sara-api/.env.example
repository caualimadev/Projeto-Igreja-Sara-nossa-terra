PORT=3000

# String de conexão com o Postgres
DATABASE_URL=postgresql://usuario:senha@localhost:5432/igreja_sara

# Segredo usado para assinar os tokens JWT (troque por algo aleatório e forte em produção)
JWT_SECRET=troque_por_um_segredo_forte
JWT_EXPIRES_IN=8h

# Usados apenas pelo script de seed (npm run seed)
ADMIN_NOME=Secretaria
ADMIN_EMAIL=secretaria@saraencontro.org.br
ADMIN_SENHA=troque-esta-senha
